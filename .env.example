# ── Supabase ─────────────────────────────────────────────────────────────────
# VITE_ prefix exposes these to the browser bundle (required for auth).
# The same vars are also read by API functions server-side — no duplication needed.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # scraper only — never used in Vercel API

VITE_API_BASE_URL=

# ── Upstash Redis (rate limiting) ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Resend (email alerts) ────────────────────────────────────────────────────
RESEND_API_KEY=
DEVELOPER_ALERT_EMAIL=

# ── Affiliate link templates ─────────────────────────────────────────────────
# One var per retailer. Two formats:
#
#   Wrap (use when your network gives you a click-tracker URL):
#     AFFILIATE_SPORT_CHEK=https://network.example.com/click?url={encoded_url}
#
#   Append (use when your network wants a query param on the product URL):
#     AFFILIATE_MEC=?affid=your_tracking_id
#
# Leave a var unset (or delete the line) to return the clean URL for that retailer.

AFFILIATE_SPORT_CHEK=
AFFILIATE_SPORTING_LIFE=
AFFILIATE_RUNNING_ROOM=
AFFILIATE_BLACKTOE_RUNNING=
AFFILIATE_THE_RUNNERS_SHOP=
AFFILIATE_RUNNING_FREE=
AFFILIATE_SVP_SPORTS=
AFFILIATE_MEC=
AFFILIATE_NEW_BALANCE_CA=
AFFILIATE_HOKA=
AFFILIATE_NIKE_CA=
AFFILIATE_CULTURE_ATHLETICS=
